# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# HF_TOKEN: Optional Hugging Face token for higher-priority queue access.
# Free to create at https://huggingface.co/settings/tokens
# Improves virtual try-on reliability (authenticated > anonymous).
HF_TOKEN=""

# Firebase Configuration (required for cloud sync and authentication)
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxx"
