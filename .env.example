# ============================================================
# FlashDrobe Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# .env.local is git-ignored and will NOT be committed.
# ============================================================


# ────────────────────────────────────────────────────────────
# REQUIRED - Gemini AI API Key
# ────────────────────────────────────────────────────────────
# Used for: AI outfit recommendations, virtual try-on, fit analysis
# Get one free at: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"


# ────────────────────────────────────────────────────────────
# REQUIRED - Firebase Configuration
# ────────────────────────────────────────────────────────────
# Used for: User authentication, wardrobe sync, cloud storage
# Get these from: Firebase Console > Project Settings > General > Your apps
# You need to create a Firebase project and register a web app first.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxx"


# ────────────────────────────────────────────────────────────
# OPTIONAL - Hugging Face Token
# ────────────────────────────────────────────────────────────
# Used for: Higher-priority queue access for virtual try-on
# Without this, virtual try-on still works but may be slower
# during high-traffic periods.
# Get one free at: https://huggingface.co/settings/tokens
HF_TOKEN=""


# ────────────────────────────────────────────────────────────
# OPTIONAL - App Configuration
# ────────────────────────────────────────────────────────────
# APP_URL: Override the public URL where this app is hosted.
# Only needed if deploying behind a reverse proxy or custom domain.
# Defaults to: http://localhost:3000
APP_URL=""

# DISABLE_HMR: Set to "true" to disable Vite hot module replacement.
# Only useful for debugging HMR-related issues.
# Defaults to: false (HMR enabled)
DISABLE_HMR=""
