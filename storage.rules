rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check ownership
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Private user body photographs (Front, Left, Right, Back views)
    // Strictly accessible ONLY by the user who uploaded them
    match /users/{userId}/bodyPhotos/{fileName} {
      allow read, write, delete: if isOwner(userId);
    }

    // Private wardrobe clothing images
    match /users/{userId}/wardrobe/{fileName} {
      allow read, write, delete: if isOwner(userId);
    }

    // Private generated virtual try-on renders
    match /users/{userId}/tryOnRenders/{fileName} {
      allow read, write, delete: if isOwner(userId);
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
